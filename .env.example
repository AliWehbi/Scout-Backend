# ---------------------------------------------------------------------------
# Local development (copy to .env in Backend/)
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave unset to use SQLite (db.sqlite3). For Postgres via docker-compose.dev.yml:
# DATABASE_URL=postgres://scout:scout@localhost:5432/scout
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
INVITATION_TTL_DAYS=14

# ---------------------------------------------------------------------------
# Production: ~/scout-backend/.env on the server (never committed). See DEPLOY.md.
# Uncomment and fill in; remove the development block above.
# Secrets: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# ---------------------------------------------------------------------------
# DJANGO_SECRET_KEY=<long random value>
# DJANGO_ALLOWED_HOSTS=api.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://api.example.com
# FRONTEND_URL=https://app.example.com
#
# Database container. Use a URL-safe password (letters, digits, - and _ only).
# POSTGRES_DB=scout
# POSTGRES_USER=scout
# POSTGRES_PASSWORD=<random URL-safe value>
#
# Email (SMTP)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Scout Dashboard <no-reply@example.com>
#
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=14
# INVITATION_TTL_DAYS=14
#
# Host port the stack listens on (localhost only; the host nginx proxies to it)
# SCOUT_HTTP_PORT=8001
# GUNICORN_WORKERS=3
# LOG_LEVEL=WARNING
